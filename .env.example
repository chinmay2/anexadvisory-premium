# Property platform database connection
# Add the real value in Vercel Project Settings > Environment Variables.
# Never commit production credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Admin authentication. Use strong unique values in the deployment environment.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-random-password"
SESSION_SECRET="replace-with-a-long-random-secret"

# Property platform map provider
# OpenStreetMap tiles are used with Leaflet; no Google Maps API key is required.
NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_ATTRIBUTION="© OpenStreetMap contributors"

# Cloudflare R2 property media storage
# Create an R2 API token with Object Read & Write for the property media bucket.
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="replace-with-r2-access-key"
R2_SECRET_ACCESS_KEY="replace-with-r2-secret-key"
R2_BUCKET_NAME="anex-property-media"
R2_PUBLIC_BASE_URL="https://media.example.com"
