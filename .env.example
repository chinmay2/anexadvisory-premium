# Property platform database connection
# Add the real value in Vercel Project Settings > Environment Variables.
# Never commit production credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Property platform map provider
# OpenStreetMap tiles are used with Leaflet; no Google Maps API key is required.
NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_ATTRIBUTION="© OpenStreetMap contributors"
